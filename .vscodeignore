# The .vsix carries only dist/src, hooks, media, the nls bundles, README and LICENSE.
# Do not exclude package.nls*.json: that would silently drop the Japanese UI.
src/**
test/**
dist/test/**
.github/**
.devcontainer/**
.claude/**
# Agent instructions. Codex reads AGENTS.md from the repository root, so unlike
# SECURITY.md it cannot be tucked into .github/; it has to be excluded by name.
AGENTS.md
# Scan artifacts. Gitignored, but vsce packages untracked files too, so they need excluding here.
CLAUDE-SECURITY-*/**
**/.claude-security-run/**
.vscode/**
tmp/**
.tmp/**
node_modules/**
tsconfig.json
package-lock.json
.gitignore
.DS_Store
**/*.map
