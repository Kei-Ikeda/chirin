node_modules/
dist/
*.vsix
.DS_Store

# tmp
tmp/
.tmp/

# claude (do not track any of it: dogfooding state files, and local configs holding personal paths)
# CLAUDE.md and the skills are tracked, as assets of the repository
.claude/*
!.claude/CLAUDE.md
!.claude/skills/

# claude-security plugin scan artifacts, written to the repository root
CLAUDE-SECURITY-*/
.claude-security-run/

# Host/container-local secrets and personal settings (guarding against an accidental commit)
.devcontainer/

# vscode
.vscode/settings.json

# chirin
.claude/hooks/chirin-notify.sh
.claude/chirin-notify-state.json
.claude/.chirin-notify-tmp-*
